# Production build config — used by `npm run build`.
# Vite inlines every VITE_* value into the bundle AT BUILD TIME (not runtime), so these
# must be correct before you build. Replace the placeholder URLs below with your deployed
# HTTPS endpoints (e.g. the Render URLs for the two FastAPI services). HTTPS is required:
# the site is served over HTTPS on Hostinger, and browsers block http:// calls from it.

# Data/pipeline API (backend/app/main.py) — serves live price history + quotes.
VITE_PIPELINE_API=https://nbim-data-api.onrender.com

# Chatbot API (chatbot/server.py).
VITE_CHAT_API=https://nbim-chatbot.onrender.com

# Keep the admin pipeline tools (Refresh Holdings / Update Prices) OUT of the public build.
VITE_ENABLE_PIPELINE=false

# ── Admin sign-in (Supabase Google OAuth) ─────────────────────────────────────
# These are inlined into the public bundle at BUILD TIME and are readable by anyone.
# That is expected: the anon key is designed to be public, and the allow-list only
# controls which UI is shown. Server-side authorisation is PIPELINE_ADMIN_TOKEN in
# backend/app/main.py — never this list.
# Leaving these blank renders the footer as "Admin sign-in unavailable" and hides the tools.
VITE_SUPABASE_URL=https://zungxrzrvjromvhicuvo.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp1bmd4cnpydmpyb212aGljdXZvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4NjAxNzEsImV4cCI6MjEwMTQzNjE3MX0.T16jpvyfO82_p0g2_LEY_ZUu1XJp9CzJPeyVcimS95g
