# Local dev config — used by `npm run dev`.
# These match the fallbacks already in code; they are listed explicitly so the dev setup is
# self-documenting and so the admin pipeline tools turn on only on the local dev server.

VITE_PIPELINE_API=http://127.0.0.1:8000
VITE_CHAT_API=http://127.0.0.1:8001

# Show the admin pipeline tools (Refresh Holdings / Update Prices) locally.
VITE_ENABLE_PIPELINE=true
