# Root .env template — copy to ".env" and fill in. ".env" is gitignored.
# Used by the data pipeline in backend/pipeline/ and the API in backend/app/.

# ── Data pipeline ────────────────────────────────────────────────────────────
# Where the SQLite database lives (defaults to backend/nbim.db if unset).
DB_PATH=backend/nbim.db
# Directory holding source CSVs and snapshots.
DATA_DIR=data
# Comma-separated markets the fetch step scrapes from NBIM.
COUNTRIES=United States,United Kingdom,Germany,Canada,India,Singapore
# How often the scheduled refresh should run, in hours.
UPDATE_SCHEDULE_HOURS=24

# ── Third-party keys (pipeline only — never exposed to the browser) ──────────
# OpenFIGI is used to map ISINs to tickers. Free tier: https://www.openfigi.com/api
OPENFIGI_API_KEY=
# Mistral key for the (optional) AI report generation step.
MISTRAL_API=
# Local Ollama model name used by backend/app/llm_client.py.
OLLAMA_MODEL=mistral

# ── backend/app/main.py (the data API) ───────────────────────────────────────
# Comma-separated browser origins allowed to call this API. MUST be set in
# production — the default is localhost only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Shared secret required by the POST /api/pipeline/* admin endpoints.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave UNSET in production to disable those endpoints entirely (recommended).
PIPELINE_ADMIN_TOKEN=
# Set to 1 to expose FastAPI's /docs and /openapi.json. Leave unset in production.
ENABLE_API_DOCS=
# Set to 1 when running behind a reverse proxy (Render) so per-IP rate limiting
# reads X-Forwarded-For instead of seeing only the proxy's address.
TRUST_PROXY=
